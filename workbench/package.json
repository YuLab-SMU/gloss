{
  "name": "@gloss/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based semantic artifact viewer and inspector for gloss R figure bundles",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:singlefile": "tsc --noEmit && vite build --config vite.singlefile.config.ts",
    "build:lite": "tsc --noEmit && VITE_WORKBENCH_MODE=lite vite build --config vite.singlefile.config.ts",
    "sync:r": "npm run build:singlefile && mkdir -p ../inst/workbench && gzip -9 -c dist-singlefile/index.html > ../inst/workbench/workbench-full.html.gz",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@rive-app/react-canvas": "^4.18.4",
    "@xyflow/react": "^12.4.4",
    "ag-grid-community": "^33.1.1",
    "ag-grid-react": "^33.1.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "flatbush": "^4.4.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.0.7"
  }
}
