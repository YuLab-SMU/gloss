// gloss Project Map — Interactive Views
// Every view applies live status colors injected by `90-live-status.c4`.

views {
  view index {
    title "01 · gloss System Landscape & Alignment Overview"
    description "End-to-end map linking Design Principles, R Core, Open File Contracts, and Out-of-Core Ecosystem. Click any system to drill down."
    autoLayout LeftRight 140 100

    include
      user,
      principles,
      gloss_core,
      open_assets,
      open_assets.*,
      ecosystem

    style element.tag = #implemented {
      color done
    }
    style element.tag = #planned {
      color planned
      opacity 75%
    }
    style element.tag = #drift {
      color drift
    }
    style element.tag = #out_of_core {
      color ecosystem
      border dashed
    }
  }

  view core_architecture of gloss_core {
    title "02 · R Core Internal Architecture (Modules, Engines & APIs)"
    description "Live implementation map inside the R package. Green = implemented & verified, Slate = planned for upcoming phases, Red = alignment drift."
    autoLayout TopBottom 110 90

    include
      gloss_core.*,
      gloss_core.modules.*,
      gloss_core.engines.*,
      open_assets.asset_map,
      open_assets.asset_bundle

    style element.tag = #implemented {
      color done
    }
    style element.tag = #planned {
      color planned
      opacity 70%
    }
    style element.tag = #drift {
      color drift
    }
  }

  view public_api_surface of gloss_core.public_api {
    title "03 · Public API Surface (8 Exports Contract)"
    description "Tracks all 8 exported functions mandated by AGENTS.md against live NAMESPACE exports and man/*.Rd documentation."
    autoLayout LeftRight 130 80

    include
      user,
      gloss_core.public_api.*,
      gloss_core.modules.mod_capture,
      gloss_core.modules.mod_registry,
      gloss_core.modules.mod_package_assets,
      gloss_core.modules.mod_query

    style element.tag = #implemented {
      color done
    }
    style element.tag = #planned {
      color planned
      opacity 70%
    }
    style element.tag = #drift {
      color drift
    }
  }

  view engines_matrix of gloss_core.engines {
    title "04 · Built-in Plotting Engines Matrix"
    description "Tracks the 5 built-in engines (grid, ggplot2, patchwork, ComplexHeatmap, base) and their Suggests dependency isolation."
    autoLayout LeftRight 130 90

    include
      gloss_core.modules.mod_capture,
      gloss_core.modules.mod_registry,
      gloss_core.engines.*,
      gloss_core.modules.mod_ir_lineage

    style element.tag = #implemented {
      color done
    }
    style element.tag = #planned {
      color planned
      opacity 70%
    }
    style element.tag = #drift {
      color drift
    }
  }

  view guardrails_monitor of principles {
    title "05 · Design Intent vs Code Alignment Guardrails"
    description "Live guardrail board comparing AGENTS.md principles against automated scans of NAMESPACE, DESCRIPTION, R/, and tests/."
    autoLayout LeftRight 140 90

    include
      principles.*,
      gloss_core

    style element.tag = #guardrail_pass {
      color done
    }
    style element.tag = #guardrail_fail {
      color drift
    }
    style element.tag = #implemented {
      color done
    }
    style element.tag = #drift {
      color drift
    }
  }

  view open_contracts {
    title "06 · Open File Contracts & Outer Ecosystem"
    description "Shows how Asset Map and Asset Bundle decouple the R package from Skills, gloss-mcp, Workbench, and cross-language data tools."
    autoLayout LeftRight 140 90

    include
      gloss_core,
      open_assets.*,
      ecosystem.*

    style element.tag = #implemented {
      color done
    }
    style element.tag = #out_of_core {
      color ecosystem
      border dashed
    }
  }
}
